---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const a = messages.amenities;
const items = a.items ?? [];
const planning = a.planningPoints ?? [];
---

<!-- 游客实用设施：只按“设施类型”客观说明，不推荐任何具体商户 -->
<section id="amenities" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-6">
      <p class="text-xs uppercase tracking-[0.2em] mb-3" style="color: var(--text-muted);">{a.eyebrow}</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{a.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{a.subtitle}</p>
    </div>

    <!-- 中立声明 -->
    <p class="max-w-3xl mx-auto text-center text-xs leading-relaxed mb-10 rounded-xl px-4 py-3 border" style="color: var(--text-muted); background: var(--bg-tertiary); border-color: var(--border-color);">
      ⚖️ {a.neutralNote}
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <article class="rounded-2xl p-6 border h-full flex flex-col" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-3 mb-4">
            <span class="shrink-0 w-11 h-11 rounded-2xl flex items-center justify-center text-xl" style="background: color-mix(in srgb, var(--accent) 14%, transparent);" aria-hidden="true">{item.icon}</span>
            <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{item.title}</h3>
          </div>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">{item.summary}</p>
          <ul class="space-y-2 text-sm mt-auto" style="color: var(--text-secondary);">
            {item.points.map((p) => (
              <li class="flex gap-2">
                <span style="color: var(--accent);" aria-hidden="true">•</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          {item.distance && (
            <p class="mt-4 pt-3 border-t text-xs" style="border-color: var(--border-color); color: var(--text-muted);">📍 {item.distance}</p>
          )}
        </article>
      ))}
    </div>

    <!-- 行前准备清单 -->
    {planning.length > 0 && (
      <div class="mt-10 rounded-2xl p-6 md:p-8 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
        <h3 class="font-semibold text-xl mb-4" style="color: var(--text-primary);">🎒 {a.planningTitle}</h3>
        <ul class="grid sm:grid-cols-2 gap-3 text-sm" style="color: var(--text-secondary);">
          {planning.map((p) => (
            <li class="flex gap-3"><span style="color: var(--accent);">✓</span><span>{p}</span></li>
          ))}
        </ul>
        <p class="mt-5 text-xs leading-relaxed" style="color: var(--text-muted);">{a.disclaimer}</p>
      </div>
    )}
  </div>
</section>

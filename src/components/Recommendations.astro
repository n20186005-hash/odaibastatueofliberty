---
/**
 * 周边联动模块
 * ------------------------------------------------------------------
 * 本站是公益性质的参观信息平台，只呈现「免费、可直接走过去」的目的地。
 * 因此这里仅保留免费景点与推荐目的地，不再列出任何需要购票的盈利项目，
 * 避免在「雕像本身免费」的页面上出现引导付费的内容。
 */
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const rec = messages.recommendations;

const groups = [
  { icon: '📌', title: rec.attractionsTitle, items: rec.attractions ?? [] },
  { icon: '🧭', title: rec.toursTitle, items: rec.tours ?? [] },
];
---

<section id="recommendations" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-10 text-center" style="color: var(--text-primary);">{rec.title}</h2>

    <div class="rec-grid">
      {groups.map((g) => (
        <div class="rec-group">
          <h3 class="rec-group-title">
            <span aria-hidden="true">{g.icon}</span> {g.title}
          </h3>
          <div class="space-y-3">
            {g.items.map((a: { name: string; url: string }) => (
              <a
                href={a.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-xl p-4 border hover:shadow-md transition"
                style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-primary);"
              >
                {a.name} <span style="color: var(--accent);">↗</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

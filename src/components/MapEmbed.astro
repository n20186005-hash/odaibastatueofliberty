---
import { getI18n, getLangFromUrl } from '../i18n/ui';
import { entity, mapsEmbedUrl } from '../config/entity';
const { messages } = getI18n(Astro.url);
const m = messages.mapSection;
const l = messages.location;
const embedUrl = mapsEmbedUrl(getLangFromUrl(Astro.url));
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={embedUrl}
        class="w-full h-[320px] sm:h-[450px]"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title={`${messages.meta.officialName} — ${m.subtitle}`}
      ></iframe>
    </div>

    <!-- NAP：站内展示的名称与地址，与 Google 地图资料保持一致 -->
    <div class="mt-6 rounded-2xl p-5 border text-sm" style="background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-secondary);">
      <p class="font-semibold mb-1" style="color: var(--text-primary);">{messages.meta.officialName}（{entity.fullName}）</p>
      <p>{l.addressValue}</p>
      <p class="mt-1 text-xs" style="color: var(--text-muted);">{l.coordsLabel}: {entity.latitude}, {entity.longitude}</p>
    </div>

    <div class="text-center mt-8">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
    </div>
  </div>
</section>

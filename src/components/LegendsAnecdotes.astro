---
import { getI18n } from '../i18n/ui';
import { galleryImage } from '../config/entity';
const { messages } = getI18n(Astro.url);
const l = messages.legends;
const items = l.items ?? [];
const aside = galleryImage(3, 800);
---

<!-- 背景故事与传说：补齐“故事感”，让页面更像专业景点落地页 -->
<section id="legends" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-10 items-start">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] mb-3" style="color: var(--text-muted);">{l.eyebrow}</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{l.title}</h2>
        <p class="text-base sm:text-lg leading-relaxed mb-8" style="color: var(--text-secondary);">{l.subtitle}</p>

        <div class="space-y-5">
          {items.map((item, i) => (
            <details class="lg-card" open={i < 2}>
              <summary class="lg-summary">
                <span class="lg-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="lg-heading">
                  <span class="lg-title">{item.title}</span>
                  {item.tag && <span class="lg-tag">{item.tag}</span>}
                </span>
              </summary>
              <p class="lg-text">{item.text}</p>
            </details>
          ))}
        </div>
      </div>

      <aside class="space-y-6">
        <figure class="rounded-2xl overflow-hidden border" style="border-color: var(--border-color); background: var(--card-bg); box-shadow: var(--card-shadow);">
          <img src={aside} alt={l.imageAlt} width="800" height="600" loading="lazy" decoding="async" class="w-full h-auto block" />
          <figcaption class="px-4 py-3 text-xs" style="color: var(--text-muted);">{l.imageCaption}</figcaption>
        </figure>

        <div class="rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
          <h3 class="font-semibold mb-3" style="color: var(--text-primary);">{l.factTitle}</h3>
          <dl class="space-y-3 text-sm">
            {l.facts.map((f) => (
              <div>
                <dt class="text-xs uppercase tracking-wide mb-0.5" style="color: var(--text-muted);">{f.label}</dt>
                <dd style="color: var(--text-secondary);">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>

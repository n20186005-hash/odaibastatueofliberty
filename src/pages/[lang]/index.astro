---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionNav from '../../components/SectionNav.astro';
import Hero from '../../components/Hero.astro';
import EntryAnswers from '../../components/EntryAnswers.astro';
import Intro from '../../components/Intro.astro';
import WeatherSection from '../../components/WeatherSection.astro';
import TideSection from '../../components/TideSection.astro';
import EntityBinding from '../../components/EntityBinding.astro';
import Transport from '../../components/Transport.astro';
import Amenities from '../../components/Amenities.astro';
import Recommendations from '../../components/Recommendations.astro';
import InfoSection from '../../components/InfoSection.astro';
import HistoryTimeline from '../../components/HistoryTimeline.astro';
import ScienceArt from '../../components/ScienceArt.astro';
import LegendsAnecdotes from '../../components/LegendsAnecdotes.astro';
import OutdoorMuseum from '../../components/OutdoorMuseum.astro';
import Gallery from '../../components/Gallery.astro';
import FeaturedQuotes from '../../components/FeaturedQuotes.astro';
import VisitGuide from '../../components/VisitGuide.astro';
import Reviews from '../../components/Reviews.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import DeepDive from '../../components/DeepDive.astro';
import FAQ from '../../components/FAQ.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import { getI18n, languagesList } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { messages } = getI18n(Astro.url);
---

<BaseLayout title={messages.meta.title} description={messages.meta.description} path="">
  <Breadcrumbs />
  <SectionNav />
  <Hero />
  <EntryAnswers />
  <Intro />
  <WeatherSection />
  <TideSection />
  <EntityBinding />
  <InfoSection />
  <HistoryTimeline />
  <ScienceArt />
  <LegendsAnecdotes />
  <OutdoorMuseum />
  <Transport />
  <Amenities />
  <Recommendations />
  <FeaturedQuotes />
  <VisitGuide />
  <Gallery />
  <Reviews />
  <MapEmbed />
  <DeepDive />
  <FAQ />
  <SourcesSection />
</BaseLayout>
